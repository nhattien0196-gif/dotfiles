/*
Default configuration file for the Quickshell Statusbar.
*/
{
    "bar": {
        "height": 36,
        "reservedHeight": 58,
        "enabled": false,
        "alwaysExpanded": false
    },
    "pill": {
        "collapsedWidth": 0,
        "expandedWidth": 680,
        "radius": 20,
        "animationDuration": 350
    },
"modules": {
    "left":   ["workspaces"],
    "center": ["launcher", "clock"],
    "right":  ["volume", "battery", "powerprofile", "systemtray"]
},
    "border": {
        "width": 2,
        "colorTop": "",
        "colorBottom": ""
    },
    "opacity": {
        "collapsed": 0.75,
        "expanded": 0.88
    },
    "clock": {
        "format": "HH:mm",
        "dateFormat": "ddd, dd MMM"
    },
    "workspaces": {
        "count": 5
    }
}
