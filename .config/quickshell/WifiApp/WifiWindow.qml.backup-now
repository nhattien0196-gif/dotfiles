                            anchors.fill:
                                parent

                            cursorShape:
                                Qt.PointingHandCursor

                            onClicked: {
                                root.closePasswordPopup()
                            }
                        }
                    }


                    Rectangle {

                        width:
                            90

                        height:
                            36

                        radius:
                            10

                        color:
                            root.connecting
                            ? root.surface2
                            : root.orange


                        Text {

                            anchors.centerIn:
                                parent

                            text:
                                root.connecting
                                ? "Connecting"
                                : "Connect"

                            color:
                                root.connecting
                                ? root.textDim
                                : root.bg

                            font.pixelSize:
                                12

                            font.bold:
                                true
                        }


                        MouseArea {

                            anchors.fill:
                                parent

                            cursorShape:
                                Qt.PointingHandCursor

                            enabled:
                                !root.connecting

                            onClicked: {
                                root.connectToNetwork()
                            }
                        }
                    }
                }
            }
        }
    }
