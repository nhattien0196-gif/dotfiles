                                    if (
                                        network.connected
                                    )
                                        return "●"
                                }

                                return "○"
                            }

                            color:
                                root.orange

                            font.pixelSize:
                                12
                        }
                    }
                }


                // ====================================================
                // AVAILABLE NETWORKS
                // ====================================================

                RowLayout {

