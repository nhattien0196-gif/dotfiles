                                    12
                            }
                        }


                        Text {

                            text: {

                                if (root.connecting)
                                    return "󰔟"

                                if (!root.wifiDevice)
                                    return "󰖪"

                                for (
                                    const network
                                    of root.wifiDevice
                                        .networks.values
